// ============================================================================
// Institutional LMS - database schema
// Postgres + Prisma. Multi-tenant by `institutionId` (shared schema, scoped
// queries, optional Postgres RLS in production - see docs/DATABASE.md).
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums ----

