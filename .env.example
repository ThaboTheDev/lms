# ---- core -------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME="MSRI"
# The institution's time zone. Times typed into forms (a due date of 17:00)
# carry no zone and are read in this one, and pages display times in it.
# Leave the server on UTC and every deadline lands two hours late.
TZ=Africa/Johannesburg
# Slug of the institution the public application form belongs to.
# Leave blank on a single-institution deployment.
PUBLIC_INSTITUTION_SLUG=

# 32+ byte secret used to sign session cookies and hash tokens.
# Generate with: openssl rand -base64 48
AUTH_SECRET=

# Optional. /setup creates the first institution and administrator, and only
# while the database has no users at all. Set this and it asks for the same
# value too: worth it when the server is reachable before you get to it.
# 16+ characters; a blank value counts as unset. Remove it once setup is done.
# Generate with: openssl rand -base64 24
# SETUP_TOKEN=

# ---- database ---------------------------------------------------------
DATABASE_URL=postgresql://lms:lms@localhost:5432/lms?schema=public
# Prisma connection pool sizes per process. With Postgres max_connections=40
# on the 4 GB VPS: app 5 + worker 3 + migrate 1 leaves headroom for backups.
DB_POOL=5
DB_POOL_WORKER=3

# ---- session ----------------------------------------------------------
SESSION_TTL_HOURS=12
SESSION_IDLE_TIMEOUT_MINUTES=120

# ---- object storage (S3 compatible: AWS S3, MinIO, Cloudflare R2) ------
# local (development: files under ./storage) | s3 (production; see
# "Object storage" in docs/DEPLOYMENT.md for the bucket's CORS rule)
STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:9000
S3_REGION=af-south-1
S3_BUCKET=lms-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_MB=50

# ---- email ------------------------------------------------------------
MAIL_DRIVER=log              # log | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="MSRI <no-reply@msri.online>"

# ---- queue / cache ----------------------------------------------------
REDIS_URL=redis://localhost:6379
QUEUE_DRIVER=memory          # memory | redis

# ---- security ---------------------------------------------------------
RATE_LIMIT_DRIVER=memory     # memory | redis
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# Optional malware scanner for uploads. Without it, files are recorded as
# SKIPPED rather than CLEAN: the system does not claim a check it did not make.
MALWARE_SCANNER_URL=
MALWARE_SCANNER_TOKEN=

# ---- backup -----------------------------------------------------------
# Days to keep nightly dumps on disk. 7 because they live on the VPS: 35 days
# is the target only after dumps are copied off a 50 GB disk shared with
# Moodle, which cannot hold them.
BACKUP_RETENTION_DAYS=7
